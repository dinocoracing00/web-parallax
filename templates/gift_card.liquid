{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Tarjeta regalo &ndash; {{ shop.name }}</title>
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main class="password">
      {% render 'wordmark' %}
      <div class="newsletter" style="margin-top:3rem">
        <span class="eyebrow">Tarjeta regalo</span>
        <h1 class="h2">{{ gift_card.initial_value | money }}</h1>
        {%- if gift_card.enabled == false or gift_card.expired -%}
          <p>Esta tarjeta ya no está disponible.</p>
        {%- endif -%}
        <p style="opacity:.75">Saldo disponible: {{ gift_card.balance | money }}</p>
        <p style="font-size:1.4rem;letter-spacing:.2em;margin:2rem 0">{{ gift_card.code | format_code }}</p>
        {%- if gift_card.expires_on -%}
          <p style="opacity:.75">Válida hasta el {{ gift_card.expires_on | date: '%d/%m/%Y' }}</p>
        {%- endif -%}
        <a href="{{ shop.url }}" class="button button--light" style="margin-top:2rem">Ir a la tienda</a>
      </div>
    </main>
  </body>
</html>
