{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
-%}

<section class="page-width">
  <div class="product">
    <div class="product__gallery">
      {%- for media in product.media -%}
        <div class="product__gallery-item">
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {%- liquid
                assign image_loading = 'lazy'
                if forloop.first
                  assign image_loading = 'eager'
                endif
                assign media_alt = media.alt | default: product.title
              -%}
              {{
                media
                | image_url: width: 1800
                | image_tag:
                  loading: image_loading,
                  sizes: '(min-width: 990px) 55vw, 100vw',
                  widths: '550, 750, 1100, 1500, 1800',
                  alt: media_alt
              }}
            {%- when 'video' -%}
              {{ media | video_tag: autoplay: true, loop: true, muted: true, controls: false }}
            {%- else -%}
              {{ media | media_tag }}
          {%- endcase -%}
        </div>
      {%- else -%}
        <div class="product__gallery-item">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
      {%- endfor -%}
    </div>

    <div class="product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'vendor' -%}
            <span class="eyebrow" {{ block.shopify_attributes }}>{{ product.vendor | escape }}</span>

          {%- when 'title' -%}
            <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

          {%- when 'price' -%}
            <div class="product__price" id="ProductPrice-{{ section.id }}" {{ block.shopify_attributes }}>
              {% render 'price', product: product, variant: current_variant %}
            </div>

          {%- when 'text' -%}
            <div class="rte text-muted" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

          {%- when 'buy_buttons' -%}
            <div
              data-product-form
              data-price-target="#ProductPrice-{{ section.id }}"
              data-money-format="{{ shop.money_format | escape }}"
              {{ block.shopify_attributes }}
            >
              {%- form 'product', product, id: form_id, class: 'product__form' -%}
                <script type="application/json" data-product-json>
                  [
                    {%- for variant in product.variants -%}
                      {"id": {{ variant.id }}, "available": {{ variant.available }}, "price": {{ variant.price }}, "compare_at_price": {{ variant.compare_at_price | default: 0 }}, "options": {{ variant.options | json }}}{% unless forloop.last %},{% endunless %}
                    {%- endfor -%}
                  ]
                </script>
                <input type="hidden" name="id" value="{{ current_variant.id }}">

                {%- unless product.has_only_default_variant -%}
                  {%- for option in product.options_with_values -%}
                    <div class="field">
                      <label for="Option-{{ section.id }}-{{ forloop.index0 }}">{{ option.name | escape }}</label>
                      <select id="Option-{{ section.id }}-{{ forloop.index0 }}" class="select" data-option-index="{{ forloop.index0 }}">
                        {%- for value in option.values -%}
                          <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value | escape }}</option>
                        {%- endfor -%}
                      </select>
                    </div>
                  {%- endfor -%}
                {%- endunless -%}

                {%- if block.settings.show_quantity -%}
                  <div class="field">
                    <label for="Quantity-{{ section.id }}">Cantidad</label>
                    <div class="quantity">
                      <button type="button" data-quantity-change="-1" aria-label="Restar uno">&minus;</button>
                      <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1">
                      <button type="button" data-quantity-change="1" aria-label="Sumar uno">+</button>
                    </div>
                  </div>
                {%- endif -%}

                <button type="submit" name="add" class="button button--full"{% unless current_variant.available %} disabled{% endunless %}>
                  <span>{% if current_variant.available %}Añadir a la cesta{% else %}Agotado{% endif %}</span>
                </button>

                {%- if block.settings.show_dynamic_checkout -%}
                  <div style="margin-top:.75rem">{{ form | payment_button }}</div>
                {%- endif -%}
              {%- endform -%}
            </div>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="product__description rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}

          {%- when 'accordion' -%}
            <details class="accordion" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading | escape }}</summary>
              <div class="accordion__content rte">
                {{ block.settings.content }}
                {%- if block.settings.page != blank -%}
                  {{ block.settings.page.content }}
                {%- endif -%}
              </div>
            </details>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_media -%}
      "image": [{{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}],
    {%- endif -%}
    "description": {{ product.description | strip_html | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price": {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "url": {{ request.origin | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Producto",
  "tag": "div",
  "blocks": [
    { "type": "vendor", "name": "Marca", "limit": 1 },
    { "type": "title", "name": "Título", "limit": 1 },
    { "type": "price", "name": "Precio", "limit": 1 },
    {
      "type": "text",
      "name": "Texto",
      "settings": [{ "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Texto del producto</p>" }]
    },
    {
      "type": "buy_buttons",
      "name": "Botones de compra",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_quantity", "label": "Mostrar selector de cantidad", "default": true },
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Mostrar botón de pago rápido", "default": true }
      ]
    },
    { "type": "description", "name": "Descripción", "limit": 1 },
    {
      "type": "accordion",
      "name": "Desplegable",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Envío y devoluciones" },
        { "type": "richtext", "id": "content", "label": "Contenido" },
        { "type": "page", "id": "page", "label": "Contenido de una página" }
      ]
    }
  ]
}
{% endschema %}
