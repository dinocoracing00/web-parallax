<div class="page-width">
  <header class="collection-hero">
    <h1>Buscar</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="newsletter" style="margin-top:0">
      <div class="newsletter__form">
        <label for="SearchInput" class="visually-hidden">Buscar</label>
        <input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" class="input" placeholder="¿Qué estás buscando?">
        <input type="hidden" name="type" value="product">
        <button type="submit">Buscar</button>
      </div>
    </form>
  </header>

  {%- if search.performed -%}
    {%- paginate search.results by 16 -%}
      <p class="center text-muted" style="margin-bottom:2.5rem">
        {{ search.results_count }} {% if search.results_count == 1 %}resultado{% else %}resultados{% endif %} para «{{ search.terms | escape }}»
      </p>
      {%- if search.results_count > 0 -%}
        <ul class="product-grid" style="--columns: 4">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              <li>{% render 'product-card', product: item, index: forloop.index %}</li>
            {%- else -%}
              <li>
                <a href="{{ item.url }}">
                  <h3 class="product-card__title">{{ item.title | escape }}</h3>
                  <p class="text-muted">{{ item.content | strip_html | truncatewords: 20 }}</p>
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Paginación">{{ paginate | default_pagination }}</nav>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}

  <div style="height: clamp(4rem, 8vw, 7rem)"></div>
</div>

{% schema %}
{
  "name": "Búsqueda",
  "tag": "section"
}
{% endschema %}
