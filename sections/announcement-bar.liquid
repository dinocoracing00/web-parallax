{%- if section.settings.text != blank -%}
  <div class="announcement-bar" {{ section.shopify_attributes }}>
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
    {%- else -%}
      {{ section.settings.text | escape }}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncios",
  "class": "announcement-bar-section",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Texto",
      "default": "Envío gratuito en pedidos superiores a 150 €"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
