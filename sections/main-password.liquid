<div class="password">
  {% render 'wordmark' %}

  <div class="newsletter" style="margin-top:3rem">
    {%- if section.settings.title != blank -%}
      <h1 class="h2">{{ section.settings.title | escape }}</h1>
    {%- endif -%}
    {%- if shop.password_message != blank -%}
      <p style="opacity:.75">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, prelanzamiento">
      {%- if form.posted_successfully? -%}
        <p class="form-message" style="margin-top:2rem">Gracias. Te avisaremos en cuanto abramos.</p>
      {%- else -%}
        <div class="newsletter__form">
          <label for="PasswordNewsletter" class="visually-hidden">Correo electrónico</label>
          <input id="PasswordNewsletter" type="email" name="contact[email]" class="input" placeholder="Tu correo electrónico" required>
          <button type="submit">Avisarme</button>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>

  <details class="password__login">
    <summary>Acceso con contraseña</summary>
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p class="form-message form-message--error" style="margin-top:1rem">Contraseña incorrecta.</p>
      {%- endif -%}
      <div class="newsletter__form" style="margin-top:1.5rem">
        <label for="Password" class="visually-hidden">Contraseña</label>
        <input id="Password" type="password" name="password" class="input" placeholder="Contraseña" autocomplete="current-password">
        <button type="submit">Entrar</button>
      </div>
    {%- endform -%}
  </details>
</div>

{% schema %}
{
  "name": "Contraseña",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Muy pronto" }
  ]
}
{% endschema %}
