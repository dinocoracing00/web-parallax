{%- paginate blog.articles by 9 -%}
  <div class="page-width">
    <header class="collection-hero">
      <span class="eyebrow">Journal</span>
      <h1>{{ blog.title | escape }}</h1>
    </header>

    <ul class="product-grid" style="--columns: 3">
      {%- for article in blog.articles -%}
        <li data-reveal>
          <a href="{{ article.url }}" class="product-card">
            <div class="product-card__media" style="--card-ratio: 3 / 2">
              {%- if article.image -%}
                {{ article.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 50vw', widths: '450, 700, 900, 1200', alt: article.title }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="product-card__vendor">{{ article.published_at | date: '%d.%m.%Y' }}</div>
            <h2 class="product-card__title">{{ article.title | escape }}</h2>
            <p class="text-muted">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Paginación">{{ paginate | default_pagination }}</nav>
    {%- endif -%}
    <div style="height: clamp(4rem, 8vw, 7rem)"></div>
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog",
  "tag": "section"
}
{% endschema %}
